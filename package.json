{
  "name": "@tencent/ags-remote-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote multi-user browser MCP server: OAuth2 Resource Server + AgentSandbox backend, wrapping Playwright's built-in MCP (playwright-core) via createConnection.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ags-remote-mcp": "./lib/cli.js"
